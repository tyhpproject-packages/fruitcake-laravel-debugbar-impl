{
    "name": "tyhpdef/fruitcake-laravel-debugbar-impl",
    "description": "Implementation package for tyhpdef/fruitcake-laravel-debugbar. Require tyhpdef/fruitcake-laravel-debugbar, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "4.4.3.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev",
                "tyhpdef/php-debugbar-php-debugbar": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/fruitcake-laravel-debugbar"
        }
    },
    "require": {
        "php": ">=8.2",
        "fruitcake/laravel-debugbar": "4.4.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev",
        "tyhpdef/php-debugbar-php-debugbar": "@dev"
    }
}
